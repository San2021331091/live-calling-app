{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.go": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api?__vercel_path=/"
    },
    {
      "source": "/:path*",
      "destination": "/api?__vercel_path=/:path*"
    }
  ]
}
