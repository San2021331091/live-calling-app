DATABASE_URL=postgres://postgres:postgres@localhost:5432/voxa?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=8080
FCM_ENABLED=false
# Required when FCM_ENABLED=true; use the same Firebase project as the Android app.
FIREBASE_PROJECT_ID=
# Absolute path or path relative to backend/. Never copy this file into Flutter.
GOOGLE_APPLICATION_CREDENTIALS=secrets/firebase_service_account.json
# For serverless deployments, provide the service-account JSON directly instead.
FIREBASE_SERVICE_ACCOUNT_JSON=
# VoxaAI: only the always-on Go worker needs this key; never put it in Flutter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
PEXELS_API_KEY=
TAVILY_API_KEY=
